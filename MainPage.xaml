<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Jogo_da_Velha.MainPage"
             BackgroundImageSource="fundo1.jpg">
                 
                 
    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent"></Setter>
            <Setter Property="CornerRadius" Value="15"></Setter>
            <Setter Property="TextColor" Value="Black"></Setter>
            <Setter Property="FontSize" Value="80"></Setter>
            <Setter Property="BorderWidth" Value="1"></Setter>
            <Setter Property="BorderColor" Value="Black"></Setter>
        </Style>
        <Style TargetType="Label">
            <Setter Property="BackgroundColor" Value="Transparent"></Setter>
            <Setter Property="FontSize" Value="30"></Setter>
            <Setter Property="TextColor" Value="White"></Setter>
        </Style>
        
    </ContentPage.Resources>

    <Grid RowDefinitions="*, *, *, *" 
          ColumnDefinitions="*, *, *"
          ColumnSpacing="10" RowSpacing="10" Margin="10">

        <Button x:Name="btn10" Grid.Row="1" Grid.Column="0" Clicked="Button_Clicked"></Button>
        <Button x:Name="btn11" Grid.Row="1" Grid.Column="1" Clicked="Button_Clicked"></Button>
        <Button x:Name="btn12" Grid.Row="1" Grid.Column="2" Clicked="Button_Clicked"></Button>

        <Button x:Name="btn20" Grid.Row="2" Grid.Column="0" Clicked="Button_Clicked"></Button>
        <Button x:Name="btn21" Grid.Row="2" Grid.Column="1" Clicked="Button_Clicked"></Button>
        <Button x:Name="btn22"  Grid.Row="2" Grid.Column="2" Clicked="Button_Clicked"></Button>

        <Button x:Name="btn30" Grid.Row="3" Grid.Column="0" Clicked="Button_Clicked"></Button>
        <Button x:Name="btn31" Grid.Row="3" Grid.Column="1" Clicked="Button_Clicked"></Button>
        <Button x:Name="btn32" Grid.Row="3" Grid.Column="2" Clicked="Button_Clicked"></Button>
    </Grid>

</ContentPage>
